{
  "name": "open-toontown-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:toolchain": "./browser/scripts/bootstrap-toolchain.sh && ./browser/scripts/build-engine.sh",
    "build:server": "./browser/scripts/build-native-server-engine.sh",
    "build:astron-linux": "./browser/scripts/build-astron-linux.sh",
    "build:wasm": "./browser/scripts/build-browser.sh",
    "build:game": "./browser/scripts/fetch-game-assets.sh && ./browser/scripts/build-browser.sh --game --release",
    "build:game:debug": "./browser/scripts/fetch-game-assets.sh && ./browser/scripts/build-browser.sh --game",
    "start": "./browser/scripts/run-local-stack.sh",
    "start:linux": "./browser/scripts/run-linux-stack.sh",
    "gateway": "node ./browser/gateway/server.mjs",
    "serve": "node ./browser/scripts/serve.mjs ./dist-web",
    "upload:r2-assets": "node ./browser/scripts/upload-r2-assets.mjs ./dist-web",
    "test:gateway": "node ./browser/tests/gateway_smoke.mjs",
    "test:gateway-limits": "node ./browser/tests/gateway_proxy_limits.mjs",
    "test:gateway-bootstrap": "node ./browser/tests/gateway_bootstrap_session.mjs",
    "test:gateway-lease": "node ./browser/tests/gateway_lease.mjs",
    "test:bootstrap-session": "node ./browser/tests/bootstrap_session.mjs",
    "test:bootstrap-production": "node ./browser/tests/bootstrap_production_smoke.mjs",
    "test:r2-assets": "node ./browser/tests/r2_assets.mjs",
    "test:asset-worker": "node ./browser/tests/asset_worker_gateway.mjs",
    "test:secure-asset-cache": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_secure_asset_cache.py",
    "test:browser-python-pruning": "python3 -m unittest browser.tests.test_browser_python_pruning",
    "test:browser-dc-pruning": "python3 -m unittest browser.tests.test_browser_dc_pruning",
    "test:battle-sound-index": "python3 -m unittest browser.tests.test_battle_sound_index",
    "test:short-audio-banks": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 -m unittest browser.tests.test_short_audio_banks",
    "test:short-audio-runtime": "node ./browser/tests/short_audio_banks.mjs",
    "test:short-audio-browser": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_short_audio_banks.py",
    "test:gateway-astron-idle": "node ./browser/tests/gateway_astron_idle.mjs",
    "test:audio": "python3 browser/tests/smoke_browser_audio.py",
    "test:advanced": "python3 browser/tests/smoke_advanced_settings.py",
    "test:display": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_display_settings.py",
    "test:fps": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_fps_cap.py",
    "test:browser": "python3 browser/tests/smoke_browser.py",
    "test:focus": "python3 browser/tests/smoke_canvas_focus.py",
    "test:mobile-portrait": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_mobile_portrait_controls.py",
    "test:mobile-portrait-gameplay": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_mobile_portrait_gameplay.py",
    "test:mobile-keyboard": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_mobile_keyboard.py",
    "test:transparency": "python3 browser/tests/smoke_transparency.py",
    "test:tree-transparency": "python3 browser/tests/smoke_tree_transparency.py",
    "test:tunnel-sign": "python3 browser/tests/smoke_tunnel_sign_camera.py",
    "test:go-home": "python3 browser/tests/smoke_go_home.py",
    "test:house": "python3 browser/tests/smoke_house_interior.py",
    "test:estate-surfaces": "python3 browser/tests/smoke_estate_surfaces.py",
    "test:estate-native": "./browser/scripts/test-estate-native-contracts.sh",
    "test:bingo-native": "./browser/scripts/test-fish-bingo-native-contracts.sh",
    "test:bingo-browser": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_fish_bingo.py",
    "test:estate-transactions": "python3 browser/tests/test_estate_transactions.py",
    "test:keybinds": "python3 browser/tests/smoke_keybinds.py",
    "test:keybind-chat": "python3 browser/tests/smoke_keybind_chat.py",
    "test:trolley-input-native": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 -m unittest browser.tests.test_trolley_keybinds",
    "test:mouse-look": "npm run test:mouse-look-native && python3 browser/tests/smoke_mouse_look.py",
    "test:mouse-look-native": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 browser/tests/test_mouse_look_native.py",
    "test:free-camera-native": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 browser/tests/test_free_camera_native.py",
    "test:free-camera-browser": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_free_camera.py",
    "test:sprint-native": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 browser/tests/test_sprint_visuals_native.py",
    "test:emote-67-native": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 browser/tests/test_emote_67_native.py",
    "test:emote-67-browser": "python3 browser/tests/smoke_emote_67.py",
    "test:reactive-native": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 browser/tests/test_reactive_gags_native.py",
    "test:reactive-movie-native": "PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 browser/tests/test_reactive_movie_native.py",
    "test:reactive-movie-browser": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_reactive_gag_movies.py",
    "test:reactive-ui-browser": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_reactive_gag_ui.py",
    "test:mega-native": "python3 -m unittest browser.tests.test_mega_building_rules && PYTHONPATH=.toolchain/build/panda3d-native-server:. python3.12 -m unittest browser.tests.test_mega_building_native",
    "test:login-disconnect": "python3 browser/tests/smoke_login_disconnect.py",
    "test:login-idle": "python3 browser/tests/smoke_login_idle.py",
    "test:gateway-runtime-handoff": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_gateway_runtime_handoff.py",
    "test:login": "python3 browser/tests/smoke_login_flow.py",
    "test:password-auth": "python3 -m unittest browser.tests.test_password_credentials",
    "test:login-rate-limit": "python3 -m unittest browser.tests.test_login_attempt_limiter",
    "test:password-rejection": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_password_rejection.py",
    "test:unknown-login": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_unknown_login_rejection.py",
    "test:classic-login": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_classic_boot_login.py",
    "test:avatar-logout": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_avatar_chooser_logout.py",
    "test:create-account-screen": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_create_account_screen.py",
    "test:phase-streaming": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_phase_streaming.py",
    "test:phase-handoff-failure": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_phase_handoff_failure.py",
    "test:performance-telemetry": ".build-wasm/playwright-venv/bin/python browser/tests/smoke_performance_telemetry.py",
    "test:browser-streaming-policy": "python3 -m unittest browser.tests.test_browser_streaming_policy",
    "test:browser-network": "python3 browser/tests/smoke_browser_network.py",
    "test:server-authority": "./browser/scripts/test-server-authority-contracts.sh",
    "test:server": "./browser/scripts/test-native-server.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "wrangler": "^4.113.0"
  }
}
