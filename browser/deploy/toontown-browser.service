[Unit]
Description=Toontown Browser game stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toontown-browser
Group=toontown-browser
WorkingDirectory=/srv/toontown-browser/app
EnvironmentFile=-/etc/toontown-browser/environment
Environment=TOONTOWN_LOG_DIR=/srv/toontown-browser/logs
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/toontown-browser/app/browser/scripts/run-linux-stack.sh
Restart=on-failure
RestartSec=5s
SuccessExitStatus=143
TimeoutStopSec=30s
KillMode=control-group
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/toontown-browser/logs
ReadWritePaths=/srv/toontown-browser/app/astron/databases
ReadWritePaths=/srv/toontown-browser/app/astron/logs
ReadWritePaths=/srv/toontown-browser/app/data
LimitNOFILE=8192
TasksMax=512
CPUQuota=400%
MemoryHigh=6G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
