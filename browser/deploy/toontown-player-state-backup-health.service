[Unit]
Description=Verify Toontown Browser player-state backup freshness

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/toontown-player-state-backup-health
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/var/lib/toontown-player-state-backup
