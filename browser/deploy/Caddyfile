{
	admin 127.0.0.1:2019
}

toontown.lui.ss {
	encode zstd gzip

	route {
		# The origin is not a second public entrance. Only Cloudflare's current
		# published networks may reach the application or WebSocket gateway.
		# Caddy's automatic HTTP-01/TLS-ALPN challenge handlers run outside this
		# application route, so certificate renewal remains available.
		@cloudflare {
			remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}
		handle @cloudflare {
			@astron path /astron
			reverse_proxy @astron 127.0.0.1:7200 {
				header_up X-Toontown-Client-IP {http.request.header.CF-Connecting-IP}
			}

			reverse_proxy 127.0.0.1:8180 {
				header_up X-Toontown-Client-IP {http.request.header.CF-Connecting-IP}
			}
		}
		respond "Origin access is not available" 403
	}

	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com wss://toontown.lui.ss; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}
}
