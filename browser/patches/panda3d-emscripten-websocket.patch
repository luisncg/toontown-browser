+#if defined(__EMSCRIPTEN__) && !defined(CPPPARSER)
+/**
+ * Opens a browser-native WebSocket.  Each binary WebSocket message is one
+ * Panda datagram; a small loopback gateway adds/removes Astron's two-byte TCP
+ * length prefix. A hidden iOS page can lose its browser WebSocket even though
+ * the game session remains recoverable, so the transport can rebind to the
+ * gateway's short-lived retained Astron connection.
+ */
+bool CConnectionRepository::
+connect_websocket(const std::string &url) {
+  ReMutexHolder holder(_lock);
+
+  disconnect();
+  if (!emscripten_websocket_is_supported()) {
+    return false;
+  }
+
+  _websocket_url = url;
+  _websocket_allow_reconnect = true;
+  _websocket_reconnecting = false;
+  _websocket_reconnect_deadline = 0.0;
+  _websocket_reconnect_attempts = 0;
+  EmscriptenVisibilityChangeEvent visibility;
+  if (emscripten_get_visibility_status(&visibility) == EMSCRIPTEN_RESULT_SUCCESS) {
+    _websocket_page_hidden = visibility.hidden;
+    if (visibility.hidden) {
+      _websocket_last_hidden_at = emscripten_get_now();
+    }
+  }
+  emscripten_set_visibilitychange_callback(
+    this, true, websocket_on_visibility_change);
+  return open_websocket(false);
+}
+
+bool CConnectionRepository::
+open_websocket(bool reconnect) {
+  std::string socket_url = _websocket_url;
+  if (reconnect) {
+    socket_url += socket_url.find('?') == std::string::npos
+      ? "?reconnect=1" : "&reconnect=1";
+  }
+
+  EmscriptenWebSocketCreateAttributes attributes;
+  emscripten_websocket_init_create_attributes(&attributes);
+  attributes.url = socket_url.c_str();
+  attributes.protocols = nullptr;
+  attributes.createOnMainThread = true;
+
+  EMSCRIPTEN_WEBSOCKET_T socket = emscripten_websocket_new(&attributes);
+  if (socket <= 0) {
+    return false;
+  }
+
+  _websocket = socket;
+  _websocket_connecting = true;
+  _websocket_reconnecting = reconnect;
+  if (emscripten_websocket_set_onopen_callback(socket, this, websocket_on_open) != EMSCRIPTEN_RESULT_SUCCESS ||
+      emscripten_websocket_set_onmessage_callback(socket, this, websocket_on_message) != EMSCRIPTEN_RESULT_SUCCESS ||
+      emscripten_websocket_set_onerror_callback(socket, this, websocket_on_error) != EMSCRIPTEN_RESULT_SUCCESS ||
+      emscripten_websocket_set_onclose_callback(socket, this, websocket_on_close) != EMSCRIPTEN_RESULT_SUCCESS) {
+    emscripten_websocket_close(socket, 1000, "callback setup failed");
+    emscripten_websocket_delete(socket);
+    _websocket = 0;
+    _websocket_connecting = false;
+    return false;
+  }
+
+  return true;
+}
+
+void CConnectionRepository::
+schedule_websocket_retry() {
+  if (!_websocket_allow_reconnect ||
+      emscripten_get_now() >= _websocket_reconnect_deadline) {
+    _websocket_connecting = false;
+    _websocket_reconnecting = false;
+    return;
+  }
+
+  _websocket_connecting = true;
+  _websocket_reconnecting = true;
+  unsigned int exponent =
+    _websocket_reconnect_attempts < 4u ? _websocket_reconnect_attempts : 4u;
+  int delay_ms = 250 * (1 << exponent);
+  ++_websocket_reconnect_attempts;
+  emscripten_async_call(websocket_retry, this, delay_ms);
+}
+
+void CConnectionRepository::
+websocket_retry(void *user_data) {
+  CConnectionRepository *self = static_cast<CConnectionRepository *>(user_data);
+  ReMutexHolder holder(self->_lock);
+  if (!self->_websocket_allow_reconnect || self->_websocket_open ||
+      self->_websocket != 0) {
+    return;
+  }
+  if (emscripten_get_now() >= self->_websocket_reconnect_deadline) {
+    self->_websocket_connecting = false;
+    self->_websocket_reconnecting = false;
+    return;
+  }
+  if (!self->open_websocket(true)) {
+    self->schedule_websocket_retry();
+  }
+}
+
+void CConnectionRepository::
+send_websocket_visibility() {
+  if (!_websocket_open || _websocket == 0) {
+    return;
+  }
+  emscripten_websocket_send_utf8_text(
+    _websocket,
+    _websocket_page_hidden
+      ? "toontown:visibility:hidden"
+      : "toontown:visibility:visible");
+}
+
+bool CConnectionRepository::
+websocket_on_visibility_change(
+    int, const EmscriptenVisibilityChangeEvent *event, void *user_data) {
+  CConnectionRepository *self = static_cast<CConnectionRepository *>(user_data);
+  ReMutexHolder holder(self->_lock);
+  self->_websocket_page_hidden = event->hidden;
+  if (event->hidden) {
+    self->_websocket_last_hidden_at = emscripten_get_now();
+  }
+  self->send_websocket_visibility();
+  return true;
+}
+
+bool CConnectionRepository::
+is_websocket_open() {
+  ReMutexHolder holder(_lock);
+  return _websocket_open;
+}
+
+bool CConnectionRepository::
+is_websocket_connecting() {
+  ReMutexHolder holder(_lock);
+  return _websocket_connecting;
+}
+
+bool CConnectionRepository::
+websocket_on_open(int, const EmscriptenWebSocketOpenEvent *event,
+                  void *user_data) {
+  CConnectionRepository *self = static_cast<CConnectionRepository *>(user_data);
+  ReMutexHolder holder(self->_lock);
+  if (self->_websocket != event->socket) {
+    return true;
+  }
+  self->_websocket_connecting = false;
+  self->_websocket_open = true;
+  self->_websocket_reconnecting = false;
+  self->_websocket_reconnect_deadline = 0.0;
+  self->_websocket_reconnect_attempts = 0;
+  if (!self->_websocket_page_hidden) {
+    self->_websocket_last_hidden_at = 0.0;
+  }
+  self->send_websocket_visibility();
+
+  while (!self->_websocket_outgoing.empty()) {
+    Datagram &dg = self->_websocket_outgoing.front();
+    EMSCRIPTEN_RESULT result = emscripten_websocket_send_binary(
+      self->_websocket, const_cast<void *>(dg.get_data()), dg.get_length());
+    if (result != EMSCRIPTEN_RESULT_SUCCESS) {
+      self->_websocket_open = false;
+      break;
+    }
+    self->_websocket_outgoing_bytes -= dg.get_length();
+    self->_websocket_outgoing.pop_front();
+  }
+  return true;
+}
+
+bool CConnectionRepository::
+websocket_on_message(int, const EmscriptenWebSocketMessageEvent *event,
+                     void *user_data) {
+  CConnectionRepository *self = static_cast<CConnectionRepository *>(user_data);
+  ReMutexHolder holder(self->_lock);
+
+  static const size_t max_datagram_bytes = 65535;
+  static const size_t max_queued_bytes = 8 * 1024 * 1024;
+  if (event->isText || event->numBytes == 0 ||
+      event->numBytes > max_datagram_bytes ||
+      self->_websocket_incoming_bytes + event->numBytes > max_queued_bytes) {
+    if (self->_websocket != 0) {
+      emscripten_websocket_close(self->_websocket, 1009, "invalid datagram");
+    }
+    self->_websocket_open = false;
+    self->_websocket_connecting = false;
+    return true;
+  }
+
+  self->_websocket_incoming.emplace_back(event->data, event->numBytes);
+  self->_websocket_incoming_bytes += event->numBytes;
+  return true;
+}
+
+bool CConnectionRepository::
+websocket_on_error(int, const EmscriptenWebSocketErrorEvent *, void *user_data) {
+  CConnectionRepository *self = static_cast<CConnectionRepository *>(user_data);
+  ReMutexHolder holder(self->_lock);
+  // Browsers deliver a close event after this error. That event decides
+  // whether a recently backgrounded iOS page may retry. Keep the repository
+  // logically connected until then so Python cannot observe a one-frame
+  // disconnect between the error and close callbacks.
+  return true;
+}
+
+bool CConnectionRepository::
+websocket_on_close(int, const EmscriptenWebSocketCloseEvent *event,
+                   void *user_data) {
+  CConnectionRepository *self = static_cast<CConnectionRepository *>(user_data);
+  ReMutexHolder holder(self->_lock);
+  if (self->_websocket != event->socket) {
+    emscripten_websocket_delete(event->socket);
+    return true;
+  }
+  self->_websocket_open = false;
+  self->_websocket = 0;
+  emscripten_websocket_delete(event->socket);
+
+  const double now = emscripten_get_now();
+  const bool recently_backgrounded =
+    self->_websocket_last_hidden_at > 0.0 &&
+    now - self->_websocket_last_hidden_at <= 5.0 * 60.0 * 1000.0;
+  if (self->_websocket_allow_reconnect && event->code != 1000 &&
+      event->code != 4409 &&
+      (self->_websocket_page_hidden || recently_backgrounded)) {
+    if (self->_websocket_reconnect_deadline <= 0.0) {
+      self->_websocket_reconnect_deadline = now + 5.0 * 60.0 * 1000.0;
+    }
+    self->schedule_websocket_retry();
+  } else {
+    self->_websocket_connecting = false;
+    self->_websocket_reconnecting = false;
+  }
+  return true;
+}
