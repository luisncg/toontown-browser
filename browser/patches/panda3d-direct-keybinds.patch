+
+    def _addPassThroughKeybinds(self):
+        for action in ('forward', 'reverse', 'turnLeft', 'turnRight'):
+            self.inputStateTokens.append(self._watchKeybind(action))
+
+    def _clearKeybindState(self):
+        for action in self.keybindVariables:
