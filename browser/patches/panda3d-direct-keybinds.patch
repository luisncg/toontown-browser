+    def _watchKeybind(self, action):
+        key = self._getKeybind(action)
+        if key in ('alt', 'control', 'shift'):
+            return inputState.watch(
+                action, key, '%s-up' % key,
+                inputSource=self.keybindInputSource)
+        return inputState.watchWithModifiers(
