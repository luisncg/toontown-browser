diff --git a/dtool/src/prc/notifyCategoryProxy.I b/dtool/src/prc/notifyCategoryProxy.I
--- a/dtool/src/prc/notifyCategoryProxy.I
+++ b/dtool/src/prc/notifyCategoryProxy.I
@@ -33,10 +33,20 @@ init() {
 template<class GetCategory>
 INLINE NotifyCategory *NotifyCategoryProxy<GetCategory>::
 get_unsafe_ptr() {
+#ifdef __EMSCRIPTEN__
+  // Static constructor order is not stable when Panda3D's component archives
+  // are linked into a single WebAssembly module.  Lazy initialization is the
+  // documented purpose of this proxy, so do it before evaluating the debug
+  // assertion that Emscripten exposes to Python as an AssertionError.
+  if (_ptr == nullptr) {
+    init();
+  }
+#else
   nassertd(_ptr != nullptr) {
     init();
     nout << "Uninitialized notify proxy: " << _ptr->get_fullname() << "\n";
   }
+#endif
   return _ptr;
 }
 
